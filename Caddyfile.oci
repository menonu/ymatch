# Caddy reverse proxy for OCI deployment (issue #523)
#
# Primary site: {$DOMAIN}  — public FQDN from env / GitHub var OCI_DOMAIN(_STAGING)
# Legacy site:  {$PUBLIC_IP}.nip.io — one-shot session migration page (#527), then JS
#               navigates to {$DOMAIN} (with restore_uuid when localStorage has a guest UUID)
#
# Env injected from docker-compose.oci.yml

{$DOMAIN} {
	# API requests → backend
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Uploaded images → backend static files
	handle /uploads/* {
		reverse_proxy backend:3000
	}

	# Everything else → frontend
	handle {
		reverse_proxy frontend:80
	}
}

# Legacy nip.io: serve the migration helper (not a bare 301). Browsers must load
# this origin so localStorage can be read before navigating to DuckDNS.
# Caddy still obtains a Let's Encrypt cert for the nip.io name.
{$PUBLIC_IP}.nip.io {
	handle {
		root * /srv/migrate
		templates
		rewrite * /index.html
		header Cache-Control "no-store"
		header Content-Type "text/html; charset=utf-8"
		file_server
	}
}
