# Caddy reverse proxy for OCI deployment (issue #523)
#
# Primary site: {$DOMAIN}  — public FQDN from env / GitHub var OCI_DOMAIN(_STAGING)
# Legacy site:  {$PUBLIC_IP}.nip.io → permanent redirect to {$DOMAIN}
#
# Env injected from docker-compose.oci.yml

{$DOMAIN} {
	# API requests → backend
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Uploaded images → backend static files
	handle /uploads/* {
		reverse_proxy backend:3000
	}

	# Everything else → frontend
	handle {
		reverse_proxy frontend:80
	}
}

# Keep the previous nip.io URL working by permanently redirecting to DuckDNS.
# Caddy still obtains a Let's Encrypt cert for the nip.io name so HTTPS clients
# can complete the TLS handshake before following the redirect.
{$PUBLIC_IP}.nip.io {
	redir https://{$DOMAIN}{uri} permanent
}
